+// (PuebloCTR.exe) A file right in the title's romfs root ("romfs:/textures.pak"): the romfs opened raw (as libctru's
+// romfsMountSelf: ARCHIVE_ROMFS, its level 3 from offset 0) and the file found by its name hash in the file table, so
+// the pack is read with FSFILE_Read at offsets as on the SD card (no stdio: the reads come from several threads)
+bool openRomfsFile(const char* name, Handle* file, u64* base)
+{
+    static const u32 zeros[3] = {0, 0, 0};
+    const FS_Path binary = {PATH_BINARY, sizeof(zeros), zeros};
+    if (R_FAILED(FSUSER_OpenFileDirectly(file, ARCHIVE_ROMFS, fsMakePath(PATH_EMPTY, ""), binary, FS_OPEN_READ, 0))) {
+        *file = 0;
+        return false;
+    }
+    u32 h[10] = {}, read = 0;  // header size; dir hash, dir table, file hash, file table (offset, size); data offset
+    u16 want[64];
+    u32 n = 0;
+    for (; name[n] && n < 64; n++) {
+        want[n] = (u8) name[n];
+    }
+    u32 hash = 0 ^ 123456789u;  // (the root's offset is 0)
+    for (u32 i = 0; i < n; i++) {
+        hash = (hash >> 5 | hash << 27) ^ want[i];
+    }
+    bool ok = R_SUCCEEDED(FSFILE_Read(*file, &read, 0, h, sizeof(h))) && read == sizeof(h) && h[0] == 0x28 && h[6] >= 4;
+    u32 at = ~0u;
+    if (ok) {
+        ok = R_SUCCEEDED(FSFILE_Read(*file, &read, h[5] + (hash % (h[6] / 4)) * 4, &at, 4)) && read == 4;
+    }
+    for (int hops = 0; ok && at != ~0u && hops < 4096; hops++) {
+        struct {
+            u32 parent, sibling;
+            u64 offset, size;
+            u32 next, nameBytes;
+            u16 name[64];
+        } e;
+        ok = R_SUCCEEDED(FSFILE_Read(*file, &read, h[7] + at, &e, sizeof(e))) && read >= 0x20;
+        if (ok && e.parent == 0 && e.nameBytes == n * 2 && !memcmp(e.name, want, n * 2)) {
+            *base = (u64) h[9] + e.offset;
+            return true;
+        }
+        at = e.next;
+    }
+    FSFILE_Close(*file);
+    *file = 0;
+    return false;
+}
